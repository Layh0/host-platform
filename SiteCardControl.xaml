<UserControl x:Class="practika_2.Wpf.Controls.SiteCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Margin="8" Width="280">
    <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="10" Background="White" Padding="12">
        <StackPanel>
            <TextBlock Text="🌐" FontSize="36" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding Domain}" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" Margin="0,5,0,0"/>
            <TextBlock Text="{Binding PlanName}" Foreground="#666" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding OwnerName}" HorizontalAlignment="Center" Margin="0,2"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,4">
                <Ellipse Width="10" Height="10" Fill="{Binding StatusColor}" Margin="0,0,6,0"/>
                <TextBlock Text="{Binding StatusText}"/>
            </StackPanel>

            <TextBlock Text="{Binding DiskUsageText}" HorizontalAlignment="Center" FontSize="12" Margin="0,2"/>
            <ProgressBar Value="{Binding DiskUsagePercent}" Maximum="100" Height="6" Margin="0,5" Foreground="{Binding DiskBarColor}"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                <Button Content="⚙️ Управление" Margin="0,0,8,0" Width="110"/>
                <Button Content="💳 Оплатить" Width="110"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>