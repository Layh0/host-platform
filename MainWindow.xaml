<Window x:Class="practika_2.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:practika_2.Wpf.ViewModels"
        xmlns:controls="clr-namespace:practika_2.Wpf.Controls"
        Title="Хостинг-платформа | Вариант 19" 
        Height="700" Width="1200"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <!-- Конвертер для цвета прогресс-бара -->


        <!-- Стиль для Placeholder в TextBox -->
        <Style x:Key="PlaceholderTextBox" TargetType="TextBox">
            <Setter Property="Tag" Value="Введите текст..."/>
            <Setter Property="Foreground" Value="Black"/>
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Foreground" Value="Gray"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль для кнопок -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,5,0,5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <!-- === ЛЕВАЯ ПАНЕЛЬ: Список сайтов === -->
        <Border Grid.Column="0" Background="White" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Заголовок и поиск -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                    <TextBlock Text="🌐 Мои сайты" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBox Width="250" Margin="20,0,0,0" Padding="8,4"
                             Tag="Поиск по домену..." 
                             Style="{StaticResource PlaceholderTextBox}"/>
                </StackPanel>

                <!-- Список карточек сайтов -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Sites}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <controls:SiteCardControl DataContext="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- === ПРАВАЯ ПАНЕЛЬ: Управление === -->
        <Border Grid.Column="1" Background="#F8F9FA" Padding="15">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- 🔹 Блок: Выбор тарифа -->
                    <TextBlock Text="💰 Тарифы хостинга" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

                    <!-- Выбор тарифа — исправленная версия -->
                    <ComboBox ItemsSource="{Binding HostingPlans}" 
                              SelectedItem="{Binding SelectedPlan}"
                              Margin="0,0,0,10">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Price, StringFormat=' ({0} ₽/мес)'}" 
                           Foreground="#666" Margin="4,0,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Период:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox Width="80" SelectedIndex="2">
                            <ComboBoxItem Content="1 мес"/>
                            <ComboBoxItem Content="6 мес"/>
                            <ComboBoxItem Content="12 мес" IsSelected="True"/>
                        </ComboBox>
                    </StackPanel>

                    <Button Content="📄 Сформировать счёт" 
                            Command="{Binding GenerateInvoiceCommand}"
                            Style="{StaticResource PrimaryButton}"
                            IsEnabled="{Binding SelectedPlan}"/>

                    <TextBox Text="{Binding InvoiceText, Mode=OneWay}" 
                             TextWrapping="Wrap" Height="120" IsReadOnly="True"
                             Background="White" BorderBrush="#CCC" Padding="8" Margin="0,0,0,15"/>

                    <Button Content="🔍 Проверить лимиты" 
                            Command="{Binding CheckLimitsCommand}"
                            Background="#FF9800" Foreground="White" Padding="12,6"/>

                    <!-- 🔹 Блок: Управление доменами -->
                    <TextBlock Text="🌐 Управление доменами" FontSize="18" FontWeight="Bold" 
                               Margin="0,25,0,10"/>

                    <ListBox ItemsSource="{Binding SelectedSiteDomains}" 
                             Height="100" Margin="0,0,0,10"
                             Background="White" BorderBrush="#CCC">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding DomainName}"/>
                                    <TextBlock Text="{Binding IsActive, StringFormat=' ({0})'}" 
                                               Foreground="#666" Margin="10,0,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBox Width="150" Tag="Новый домен..." 
                                 Style="{StaticResource PlaceholderTextBox}" Padding="6"/>
                        <Button Content="➕ Добавить" Margin="10,0,0,0" Padding="8,4"/>
                    </StackPanel>

                    <!-- 🔹 Блок: Форма заявки -->
                    <TextBlock Text="📝 Заявка на хостинг" FontSize="18" FontWeight="Bold" 
                               Margin="0,25,0,10"/>

                    <TextBox Text="{Binding RequestType, UpdateSourceTrigger=PropertyChanged}"
                             Tag="Тип услуги (Сайт, Почта, SSL...)" 
                             Style="{StaticResource PlaceholderTextBox}"
                             Margin="0,0,0,8" Padding="6"/>

                    <TextBox Text="{Binding RequestDescription, UpdateSourceTrigger=PropertyChanged}"
                             Height="70" TextWrapping="Wrap" 
                             Tag="Опишите задачу..." 
                             Style="{StaticResource PlaceholderTextBox}"
                             Margin="0,0,0,10" Padding="6"/>

                    <Button Content="📤 Отправить заявку" 
                            Command="{Binding SubmitRequestCommand}"
                            Style="{StaticResource PrimaryButton}"/>

                    <!-- 🔹 Блок: История платежей -->
                    <TextBlock Text="💳 История платежей" FontSize="18" FontWeight="Bold" 
                               Margin="0,25,0,10"/>

                    <ListBox ItemsSource="{Binding Payments}" Height="150"
                             Background="White" BorderBrush="#CCC" Margin="0,0,0,10">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Description}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding PaymentDate, StringFormat='{}{0:dd.MM.yyyy}'}" 
                                               Foreground="#666" FontSize="11"/>
                                    <TextBlock Text="{Binding Amount, StringFormat='Сумма: {0} ₽'}" 
                                               Foreground="#4CAF50" FontWeight="Bold"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>